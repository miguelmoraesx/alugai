# Export these as environment variables; the CLI does not load .env implicitly.
ALUGAI_DATABASE_URL=postgresql+psycopg://alugai:alugai_local@localhost:5432/alugai
ALUGAI_USER_AGENT=AlugaiCollector/0.1

# Firecrawl: export this variable OR save this line in .env.collector (gitignored).
# The CLI reads only FIRECRAWL_API_KEY from .env.collector, without interpolation.
FIRECRAWL_API_KEY=
